      bigint id PK
      bigint member_id FK
      bigint book_id FK
      datetime requested_at
      varchar status
      varchar member_note
      varchar decision_note
      bigint version
    }
    LOANS {
      bigint id PK
      bigint member_id FK
      bigint copy_id FK
